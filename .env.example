# Local CockroachDB, single-node insecure cluster started by scripts/test-db-up.
# Matches the default port/db created by scripts/test-db-up.ps1 and .sh.
ENGRAM_DATABASE_URL=postgresql://root@localhost:26257/engram?sslmode=disable

# CockroachDB Cloud (serverless) connection string. Set in Step 3 after
# `ccloud cluster create`. Leave empty locally; never commit the real value.
ENGRAM_CLOUD_DATABASE_URL=

# AWS region for Bedrock (Claude chat + Titan Text Embeddings V2). Set once
# the operator confirms model access in a region (Step 6 spike).
AWS_REGION=

# When set to 1, src/embeddings.ts and src/llm.ts return deterministic fake
# output instead of calling Bedrock. Tests run with this set so the suite
# passes with zero AWS access (CLAUDE.md rule 7). Default 1 for local/test.
ENGRAM_FAKE_BEDROCK=1
